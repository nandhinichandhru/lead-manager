# ──────────────────────────────────────────────────────────────
# Lead Manager — environment variables
# Copy this file to `.env` and fill in your local MySQL credentials.
# ──────────────────────────────────────────────────────────────

# HTTP port for the Express API (and the built React app in production)
PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=lead_manager

# Allowed origin for the React dev server (CORS)
CLIENT_ORIGIN=http://localhost:3000
